#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "uri"
require_relative "../lib/db"

API_BASE = "https://ships.hackclub.com/api/v1/ysws_entries"
BATCH = 500
MIN_CLEAN_LEN = 50

fresh = !File.exist?(DB::DB_PATH) | ARGV.include?("--full")
url = fresh ? "#{API_BASE}?all=true" : API_BASE

warn "fetching #{url}#{fresh ? ' (full)' : ' (incremental)'}..."
response = Net::HTTP.get_response(URI(url))
abort "HTTP #{response.code}: #{response.message}" unless response.is_a?(Net::HTTPSuccess)

entries = JSON.parse(response.body)
warn "fetched #{entries.size} entries"

db = DB.connection

upsert_sql = <<~SQL
  INSERT INTO projects (record_id, description, description_clean, playable_url, code_url,
                        hours_spent, name, country, ysws_name, github_username,
                        screenshot_url, github_stars, approved_at, archived_demo,
                        archived_repo, updated_at)
  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))
  ON CONFLICT(record_id) DO UPDATE SET
    description = excluded.description,
    description_clean = CASE WHEN excluded.description_clean != projects.description_clean
                             THEN excluded.description_clean ELSE projects.description_clean END,
    playable_url = excluded.playable_url,
    code_url = excluded.code_url,
    hours_spent = excluded.hours_spent,
    name = excluded.name,
    country = excluded.country,
    ysws_name = excluded.ysws_name,
    github_username = excluded.github_username,
    screenshot_url = excluded.screenshot_url,
    github_stars = excluded.github_stars,
    approved_at = excluded.approved_at,
    archived_demo = excluded.archived_demo,
    archived_repo = excluded.archived_repo,
    updated_at = CASE WHEN excluded.description_clean != projects.description_clean
                      THEN datetime('now') ELSE projects.updated_at END
SQL

total = 0
skipped = 0
ingested = 0
batch = []

flush = lambda {
  return if batch.empty?

  db.transaction do
    batch.each { |row| db.execute(upsert_sql, row) }
  end
  batch.clear
}

entries.each do |entry|
  total += 1

  record_id = entry["id"]
  next (skipped += 1) unless record_id && !record_id.empty?

  description = entry["description"]
  clean = DB.clean(description)
  next (skipped += 1) if clean.nil? || clean.length < MIN_CLEAN_LEN

  nullify = ->(v) { v == "null" ? nil : v }

  hours = entry["hours"]
  hours = hours.is_a?(Numeric) ? hours.to_f : nil
  name = nullify.(entry["display_name"])
  country = nullify.(entry["country"])
  code_url = nullify.(entry["code_url"])
  playable_url = nullify.(entry["demo_url"])
  ysws_name = entry["ysws"]
  github_username = nullify.(entry["github_username"])
  screenshot_url = nullify.(entry["screenshot_url"])
  github_stars = entry["github_stars"] || 0
  approved_at = entry["approved_at"]
  approved_at = approved_at.is_a?(Numeric) ? approved_at : nil
  archived_demo = nullify.(entry["archived_demo"])
  archived_repo = nullify.(entry["archived_repo"])

  batch << [record_id, description, clean, playable_url, code_url,
            hours, name, country, ysws_name, github_username,
            screenshot_url, github_stars, approved_at, archived_demo, archived_repo]

  if batch.size >= BATCH
    ingested += batch.size
    flush.call
  end

  if (total % 5000).zero?
    warn "\r  #{total} entries scanned, #{ingested + batch.size} ingested, #{skipped} skipped"
  end
end

ingested += batch.size
flush.call

warn "\r  done: #{total} entries scanned, #{ingested} ingested, #{skipped} skipped"
